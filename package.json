{
  "name": "vortex",
  "productName": "Vortex",
  "version": "1.0.0",
  "description": "Autonomous ultra-high performance media engine powered by yt-dlp & ffmpeg",
  "main": "dist-electron/main/index.js",
  "scripts": {
    "dev": "vite",
    "copy:wasm": "node -e \"const fs = require('fs'); fs.mkdirSync('dist-electron/main', {recursive:true}); fs.copyFileSync('node_modules/sql.js/dist/sql-wasm.wasm', 'dist-electron/main/sql-wasm.wasm');\"",
    "build": "tsc && vite build && npm run copy:wasm",
    "preview": "vite preview",
    "dist": "npm run build && electron-builder --win",
    "dist:all": "npm run build && electron-builder --win nsis msi",
    "dist:exe": "npm run build && electron-builder --win nsis",
    "dist:msi": "npm run build && electron-builder --win msi"
  },
  "author": "Vortex Team",
  "license": "MIT",
  "build": {
    "appId": "com.vortex.desktop",
    "productName": "Vortex",
    "copyright": "Copyright © 2026 Vortex Team",
    "directories": {
      "output": "release"
    },
    "asar": true,
    "asarUnpack": [
      "**/node_modules/sql.js/**/*",
      "dist-electron/main/sql-wasm.wasm"
    ],
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "build/**/*",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "msi",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Vortex",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "uninstallDisplayName": "Vortex"
    },
    "msi": {
      "oneClick": false,
      "perMachine": true,
      "runAfterFinish": true
    }
  },
  "dependencies": {
    "@mantine/core": "^7.17.8",
    "@mantine/hooks": "^7.17.8",
    "@mantine/notifications": "^7.17.8",
    "@tabler/icons-react": "^3.31.0",
    "@tanstack/react-query": "^5.61.4",
    "@types/qrcode": "^1.5.6",
    "clsx": "^2.1.1",
    "lucide-react": "^1.55.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sql.js": "^1.14.2",
    "tree-kill": "^1.2.2"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^34.2.0",
    "electron-builder": "^26.15.3",
    "postcss": "^8.4.38",
    "postcss-preset-mantine": "^1.15.0",
    "postcss-simple-vars": "^7.0.1",
    "typescript": "^5.6.3",
    "vite": "^6.1.0",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6"
  }
}
